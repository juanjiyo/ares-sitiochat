{
    "name": "davidlig/ares-irc-services",
    "description": "Modular IRC services daemon. PHP 8.5, Symfony 7.4, Clean Architecture.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "keywords": ["irc", "services", "php", "development"],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "ext-pdo_sqlite": "*",
        "amphp/amp": "^3.1",
        "amphp/socket": "^2.4",
        "doctrine/doctrine-bundle": "3.3.*",
        "doctrine/doctrine-migrations-bundle": "4.0.*",
        "doctrine/orm": "3.7.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "2.12.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/lock": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/monolog-bundle": "4.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-core": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "platform": {
            "php": "8.5.0"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Migrations\\": "migrations/",
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "architecture": "deptrac analyse --config-file=deptrac.yaml --no-progress --fail-on-uncovered --report-uncovered",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse src/ tests/ --level=max --error-format=raw --no-progress"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*",
            "docker": false
        }
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7.2",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpstan/phpstan": "^2.3.1",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpunit/phpunit": "^13.4.1"
    }
}
